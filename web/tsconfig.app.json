{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "allowSyntheticDefaultImports": true, "esModuleInterop": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noUnusedLocals": false, "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
